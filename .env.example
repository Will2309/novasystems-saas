# ==============================================================================
# NOVASYSTEMS PRO - VARIABLES DE ENTORNO PARA PRODUCCIÓN & DESARROLLO
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR Y DOMINIO
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="production"
# En local usa http://localhost:3000 | En producción usa tu dominio real con HTTPS:
NEXT_PUBLIC_APP_URL="https://novasystems.io"

# ------------------------------------------------------------------------------
# 2. CREDENCIALES DEL ADMINISTRADOR (PANEL /admin)
# ------------------------------------------------------------------------------
# Aquí defines el correo real donde recibirás los códigos OTP de seguridad 2FA:
ADMIN_EMAIL="tu-correo-real@gmail.com"
ADMIN_PASSWORD="TuContraseñaSuperSegura2026!"

# ------------------------------------------------------------------------------
# 3. SERVICIO DE CORREO REAL (RESEND - 100% RECOMENDADO PARA NEXT.JS)
# Obtén tu API Key gratis en https://resend.com (3,000 correos/mes gratis)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_123456789_abcdefgh"

# Remitente de los correos:
# En pruebas sin dominio propio puedes usar: "NovaSystems <onboarding@resend.dev>"
# En producción con dominio verificado en Resend usa: "NovaSystems Seguridad <seguridad@tu-dominio.com>"
EMAIL_FROM="NovaSystems <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 4. NOTIFICACIONES TELEGRAM (OPCIONAL - ALERTAS INSTANTÁNEAS DE LEADS)
# ------------------------------------------------------------------------------
# Crea un bot con @BotFather en Telegram y coloca aquí las credenciales:
# TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# TELEGRAM_CHAT_ID="-1001234567890"

# ------------------------------------------------------------------------------
# 5. BASE DE DATOS PERSISTENTE (POSTGRESQL / SUPABASE) (OPCIONAL)
# Actualmente el sistema opera con almacén en memoria reactivo.
# Al conectar Supabase o PostgreSQL, descomenta la siguiente variable:
# DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"
